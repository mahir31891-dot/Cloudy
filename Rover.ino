#include <avr/io.h>
#include <util/delay.h>

// ============================================================
// ARDUINO NANO + L298N + HC-SR04
// FAST FULL-TURN OBSTACLE AVOIDING ROVER
// ============================================================
//
// HC-SR04
// TRIG = D2
// ECHO = D3
//
// L298N
// IN1 = D7
// IN2 = D8
// IN3 = D9
// IN4 = D10
//
// ENA JUMPER = ON
// ENB JUMPER = ON
//
// MOTOR WIRING
// OUT1 = RIGHT MOTOR -
// OUT2 = RIGHT MOTOR +
//
// OUT3 = LEFT MOTOR +
// OUT4 = LEFT MOTOR -
//
// OBSTACLE DISTANCE = 10 CM
// ============================================================


// ============================================================
// STOP
// ============================================================

void stopMotors()
{
    PORTD &= ~(1 << PD7);

    PORTB &= ~(1 << PB0);
    PORTB &= ~(1 << PB1);
    PORTB &= ~(1 << PB2);
}


// ============================================================
// FORWARD
// ============================================================

void forward()
{
    // RIGHT MOTOR FORWARD
    PORTD &= ~(1 << PD7);
    PORTB |=  (1 << PB0);

    // LEFT MOTOR FORWARD
    PORTB |=  (1 << PB1);
    PORTB &= ~(1 << PB2);
}


// ============================================================
// BACKWARD
// ============================================================

void backward()
{
    // RIGHT MOTOR BACKWARD
    PORTD |=  (1 << PD7);
    PORTB &= ~(1 << PB0);

    // LEFT MOTOR BACKWARD
    PORTB &= ~(1 << PB1);
    PORTB |=  (1 << PB2);
}


// ============================================================
// FULL RIGHT TURN
//
// RIGHT MOTOR = BACKWARD
// LEFT MOTOR  = FORWARD
//
// This produces a fast pivot turn.
// ============================================================

void fullRightTurn()
{
    // RIGHT BACKWARD
    PORTD |=  (1 << PD7);
    PORTB &= ~(1 << PB0);

    // LEFT FORWARD
    PORTB |=  (1 << PB1);
    PORTB &= ~(1 << PB2);
}


// ============================================================
// FULL LEFT TURN
//
// RIGHT MOTOR = FORWARD
// LEFT MOTOR  = BACKWARD
// ============================================================

void fullLeftTurn()
{
    // RIGHT FORWARD
    PORTD &= ~(1 << PD7);
    PORTB |=  (1 << PB0);

    // LEFT BACKWARD
    PORTB &= ~(1 << PB1);
    PORTB |=  (1 << PB2);
}


// ============================================================
// ULTRASONIC DISTANCE
// ============================================================
//
// Faster timeout than previous version.
// ============================================================

unsigned int getDistance()
{
    unsigned int timeout;
    unsigned int duration;


    // TRIG LOW
    PORTD &= ~(1 << PD2);

    _delay_us(2);


    // TRIG HIGH
    PORTD |= (1 << PD2);

    _delay_us(10);


    // TRIG LOW
    PORTD &= ~(1 << PD2);


    // --------------------------------------------------------
    // WAIT FOR ECHO
    // --------------------------------------------------------

    timeout = 20000;

    while (!(PIND & (1 << PD3)))
    {
        if (timeout == 0)
            return 0;

        timeout--;

        _delay_us(1);
    }


    // --------------------------------------------------------
    // MEASURE ECHO
    // --------------------------------------------------------

    duration = 0;

    while (PIND & (1 << PD3))
    {
        if (duration >= 20000)
            return 0;

        duration++;

        _delay_us(1);
    }


    // --------------------------------------------------------
    // CM
    // --------------------------------------------------------

    return duration / 58;
}


// ============================================================
// SETUP
// ============================================================

void setupPins()
{
    // --------------------------------------------------------
    // HC-SR04
    // --------------------------------------------------------

    // D2 = TRIG OUTPUT
    DDRD |= (1 << PD2);

    // D3 = ECHO INPUT
    DDRD &= ~(1 << PD3);


    // --------------------------------------------------------
    // L298N
    // --------------------------------------------------------

    // D7
    DDRD |= (1 << PD7);

    // D8
    DDRB |= (1 << PB0);

    // D9
    DDRB |= (1 << PB1);

    // D10
    DDRB |= (1 << PB2);


    // --------------------------------------------------------
    // INITIAL LOW
    // --------------------------------------------------------

    PORTD &= ~(1 << PD2);
    PORTD &= ~(1 << PD7);

    PORTB &= ~(1 << PB0);
    PORTB &= ~(1 << PB1);
    PORTB &= ~(1 << PB2);


    stopMotors();
}


// ============================================================
// MAIN
// ============================================================

int main()
{
    setupPins();

    // Very short startup delay
    _delay_ms(300);


    while (1)
    {
        unsigned int distance;


        // ====================================================
        // READ DISTANCE
        // ====================================================

        distance = getDistance();


        // ====================================================
        // CLEAR
        // ====================================================

        if (distance == 0 || distance > 10)
        {
            forward();

            // Very short processing delay
            _delay_ms(15);
        }


        // ====================================================
        // OBSTACLE 10 CM OR LESS
        // ====================================================

        else
        {
            // ------------------------------------------------
            // FAST STOP
            // ------------------------------------------------

            stopMotors();

            _delay_ms(80);


            // ------------------------------------------------
            // QUICK BACKWARD
            // ------------------------------------------------

            backward();

            _delay_ms(180);


            // ------------------------------------------------
            // STOP
            // ------------------------------------------------

            stopMotors();

            _delay_ms(50);


            // ------------------------------------------------
            // FULL RIGHT TURN
            // ------------------------------------------------

            fullRightTurn();

            // FAST FULL TURN
            _delay_ms(480);


            // ------------------------------------------------
            // STOP
            // ------------------------------------------------

            stopMotors();

            _delay_ms(50);


            // ------------------------------------------------
            // IMMEDIATELY CHECK AGAIN
            // ------------------------------------------------

            distance = getDistance();


            // =================================================
            // IF STILL BLOCKED
            // =================================================

            if (distance > 0 && distance <= 10)
            {
                stopMotors();

                _delay_ms(50);


                // FULL LEFT TURN
                fullLeftTurn();

                _delay_ms(600);


                stopMotors();

                _delay_ms(50);
            }
        }
    }

    return 0;
}
